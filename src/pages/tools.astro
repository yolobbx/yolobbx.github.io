---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import { categories } from '~/config';
import { getCollection } from 'astro:content';

const cat = categories.tools;
const posts = (await getCollection('posts', ({ data }) => data.category === 'tools' && !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={cat.title} description={cat.blurb}>
  <div class="container container--narrow">
    <header class="cat-header">
      <div class="cat-header__eyebrow">{cat.eyebrow}</div>
      <h1 class="cat-header__title">{cat.title}</h1>
      <p class="cat-header__blurb">{cat.blurb}</p>
    </header>

    <PostList posts={posts} showCategory={false} />
  </div>
</BaseLayout>
