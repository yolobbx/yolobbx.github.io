---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import { categories } from '~/config';
import { getCollection } from 'astro:content';
import { tracks } from '~/data/tracks';

const cat = categories.music;
const posts = (await getCollection('posts', ({ data }) => data.category === 'music' && !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title={cat.title} description={cat.blurb}>
  <div class="container container--narrow">
    <header class="cat-header">
      <div class="cat-header__eyebrow">{cat.eyebrow}</div>
      <p class="cat-header__blurb">{cat.blurb}</p>
    </header>

    <PostList posts={posts} showCategory={false} />

    <section style="margin-top: 64px;">
      <details class="playlist" open>
        <summary class="playlist__summary">
          <span class="playlist__label">Now Playing</span>
          <span class="playlist__meta">{tracks.length} tracks</span>
          <span class="playlist__chevron" aria-hidden="true">▾</span>
        </summary>

        <ol class="tracks">
          {tracks.map((t, i) => (
            <li class="track">
              <span class="track__num">{pad(i + 1)}</span>
              <div class="track__cover">
                {t.cover ? (
                  <img src={t.cover} alt={`${t.artist} — ${t.title}`} loading="lazy" />
                ) : (
                  <span class="track__cover-ph" aria-hidden="true">♪</span>
                )}
              </div>
              <div class="track__body">
                <span class="track__title">{t.artist} — {t.title}</span>
                <audio controls preload="none">
                  <source src={t.src} type="audio/mpeg" />
                </audio>
              </div>
            </li>
          ))}
        </ol>
      </details>
    </section>
  </div>
</BaseLayout>
